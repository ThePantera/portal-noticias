# Copiar a .env y completar. Nunca subir .env al repositorio.

# PostgreSQL
DATABASE_URL="postgresql://USUARIO:CONTRASEÑA@localhost:5432/portal_dev"

# URL pública del sitio (canonical, sitemap, Open Graph)
SITE_URL="http://localhost:3000"
SITE_NAME="Portal Noticias"

# Sesiones (Fase 4): vida de la sesión en días
SESSION_TTL_DAYS=30

# Programador de publicaciones (Fase 6): secreto largo y aleatorio (openssl rand -hex 32)
CRON_SECRET=""

# Media (Fase 6): "local" o "s3"
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"
MEDIA_PUBLIC_BASE_URL="http://localhost:3000/media"
MEDIA_MAX_UPLOAD_MB=10

# Sólo con STORAGE_DRIVER="s3" (S3, Cloudflare R2, MinIO)
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
