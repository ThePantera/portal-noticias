# Copiar a .env y completar. Nunca subir .env al repositorio.

# PostgreSQL
DATABASE_URL="postgresql://portal:portal_dev@localhost:5432/portal_dev"
# Sólo en Neon (la integración de Vercel la define sola): conexión directa, sin pooler,
# para las migraciones. En local no hace falta.
# DATABASE_URL_UNPOOLED=""
# Base exclusiva para tests de integración: se BORRA en cada corrida. El nombre debe terminar en "_test".
TEST_DATABASE_URL="postgresql://portal:portal_dev@localhost:5432/portal_test"

# URL pública del sitio (canonical, sitemap, Open Graph). En Vercel, si se deja vacía,
# se usa el dominio de producción del proyecto.
SITE_URL="http://localhost:3000"
SITE_NAME="Portal Noticias"

# Base para los tests end to end: se BORRA en cada corrida. El nombre debe terminar en "_e2e".
E2E_DATABASE_URL="postgresql://portal:portal_dev@localhost:5432/portal_e2e"

# Administrador inicial que crea `npm run db:bootstrap` (en cada deploy) sólo si la base
# no tiene ninguno. Después del primer deploy conviene borrar ADMIN_PASSWORD.
ADMIN_EMAIL=""
ADMIN_NAME=""
ADMIN_PASSWORD=""

# Sesiones: vida de la cookie de sesión, en días
SESSION_TTL_DAYS=30

# Publicador de notas programadas: secreto de al menos 32 caracteres (openssl rand -hex 32).
# Vacío: POST /api/cron/publish-scheduled responde 503. Ver docs/deploy-vercel.md, paso 8.
CRON_SECRET=""

# Media (Fase 6): "local" o "s3"
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"
MEDIA_PUBLIC_BASE_URL="http://localhost:3000/media"
MEDIA_MAX_UPLOAD_MB=10

# Sólo con STORAGE_DRIVER="s3" (S3, Cloudflare R2, MinIO)
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
